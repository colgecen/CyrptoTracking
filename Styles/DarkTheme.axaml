<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cyber-Dark & Neon Accent (fütürizm) -->
    <Color x:Key="BackgroundPrimary">#0B0E14</Color>
    <Color x:Key="BackgroundSecondary">#12161F</Color>
    <Color x:Key="BackgroundTertiary">#1A1F2B</Color>
    <Color x:Key="TextPrimary">#F4F6F9</Color>
    <Color x:Key="TextSecondary">#A7B0BF</Color>
    <Color x:Key="TextMuted">#6B7380</Color>
    <Color x:Key="AccentBlue">#00D1FF</Color>
    <Color x:Key="AccentBlueHover">#66E2FF</Color>
    <Color x:Key="SuccessGreen">#0ECB81</Color>
    <Color x:Key="DangerRed">#F6465D</Color>
    <Color x:Key="WarningAmber">#F7D354</Color>
    <Color x:Key="Border">#1F2532</Color>
    <Color x:Key="BorderStrong">#2A3244</Color>

    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiary}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}"/>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>
</ResourceDictionary>
