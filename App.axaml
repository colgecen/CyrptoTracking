<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:AvaloniaAppCrypto.Converters"
             x:Class="AvaloniaAppCrypto.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AvaloniaAppCrypto/Styles/LightTheme.axaml"/>
                <ResourceInclude Source="avares://AvaloniaAppCrypto/Styles/DarkTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
            <conv:FavoriteStarColorConverter x:Key="FavoriteStarColor"/>
            <conv:PriceChangeToColorConverter x:Key="PriceChangeToColor"/>
            <conv:NumberFormatConverter x:Key="NumberFormat"/>
            <conv:PercentageFormatConverter x:Key="PercentageFormat"/>
            <conv:ActiveNavForegroundConverter x:Key="ActiveNavForegroundConverter"/>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaAppCrypto/Styles/BaseStyles.axaml"/>
    </Application.Styles>
</Application>
