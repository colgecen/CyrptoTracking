<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaAppCrypto.ViewModels"
        xmlns:views="using:AvaloniaAppCrypto.Views"
        xmlns:controls="using:AvaloniaAppCrypto.Controls"
        x:Class="AvaloniaAppCrypto.Views.MainWindow"
        Title="CryptoTrack"
        Width="1440" Height="900"
        Background="#FF0F1117"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full">
    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
    </Window.KeyBindings>
    <Grid Background="#0B0E14">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#0B0E14" BorderBrush="#1F2532" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Padding="0" CornerRadius="10"
                            Background="#12161F" BorderBrush="#1F2532" BorderThickness="1"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Menüyü aç / kapat">
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M4 7h16M4 12h16M4 17h16" Stroke="#A7B0BF" StrokeThickness="1.8" StrokeLineCap="Round"/>
                        </Viewbox>
                    </Button>
                    <Border CornerRadius="10" Width="34" Height="34" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="₿" FontSize="18" FontWeight="800"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="CryptoTrack" FontSize="16" FontWeight="700" Foreground="White"/>
                        <TextBlock Text="Pro" FontSize="9" FontWeight="700" Foreground="#00D1FF" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#12161F" CornerRadius="10" Padding="12,0" Width="360"
                        HorizontalAlignment="Center" BorderBrush="#1F2532" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="🔍" FontSize="13" Foreground="#6B7380" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery}"
                                 PlaceholderText="Coin, sembol veya kategori ara..."
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" FontSize="13" Padding="0,8"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarWidth}}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <Border Background="#0B0E14" BorderBrush="#1F2532" BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolConverter}}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Section label -->
                    <TextBlock Margin="18,18,18,10" Text="NAVİGASYON" FontSize="10" FontWeight="800"
                               Foreground="#3A414F" LetterSpacing="1.4"/>

                    <!-- Items -->
                    <ItemsControl Grid.Row="1" Margin="10,0,10,0" ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="46" Padding="0" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" CornerRadius="12" Margin="0,2"
                                        Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Page}"
                                        Classes.active="{Binding IsActive}">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                        <Style Selector="Button.active">
                                            <Setter Property="Background" Value="#12161F"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="3,36,*" Margin="10,0">
                                        <!-- Active accent bar -->
                                        <Border Grid.Column="0" Width="3" Height="22" CornerRadius="2"
                                                Background="{Binding IsActive, Converter={StaticResource ActiveNavAccentConverter}}"
                                                VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#0B0E14">
                                            <PathIcon Data="{Binding IconData}"
                                                      Width="18" Height="18"
                                                      Foreground="{Binding IsActive, Converter={StaticResource ActiveNavForegroundConverter}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13.5"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{Binding IsActive, Converter={StaticResource ActiveNavForegroundConverter}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bottom status -->
                    <Border Grid.Row="2" Margin="10,10,10,12" CornerRadius="12" Padding="12"
                            BorderBrush="#1A1F2B" BorderThickness="1" Background="#12161F">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border CornerRadius="4" Width="8" Height="8" Background="{Binding ConnectionStatusColor}"/>
                                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="#A7B0BF" FontWeight="600"/>
                            </StackPanel>
                            <TextBlock Text="v1.0.0 • Local" FontSize="10" Foreground="#3A414F" Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

                        <!-- Page Content -->
            <Border Grid.Column="1" Background="#0B0E14" Padding="0">
                <ContentControl x:Name="PageHost" />
            </Border>

        </Grid>
    </Grid>
</Window>
