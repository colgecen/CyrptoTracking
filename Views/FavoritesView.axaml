<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:AvaloniaAppCrypto.Models"
             x:Class="AvaloniaAppCrypto.Views.FavoritesView">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Favoriler" FontSize="22" FontWeight="700" Foreground="White"/>

            <Border IsVisible="{Binding FavoriteIds.Count, Converter={StaticResource InverseBoolConverter}}" 
                    Background="#1C1F2A" CornerRadius="16" Padding="48" HorizontalAlignment="Center" Margin="0,48">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="⭐" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="Henüz favori eklemediniz" FontSize="16" Foreground="#8B8FA3"/>
                    <TextBlock Text="Coin listesinden yıldıza tıklayarak favorilere ekleyin" 
                               Foreground="#5A5D6E" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding FavoritedCoins}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="models:Coin">
                        <Border Background="#1C1F2A" CornerRadius="12" Padding="16,12" Margin="0,3">
                            <Grid ColumnDefinitions="40,*,120,100,40" ColumnSpacing="12">
                                <Border CornerRadius="16" Width="36" Height="36" Background="#141724">
                                    <Image Source="{Binding Image}" Width="32" Height="32"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="600" Foreground="White"/>
                                    <TextBlock Text="{Binding Symbol}" FontSize="11" Foreground="#8B8FA3"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding CurrentPrice, StringFormat='${0:N2}'}" 
                                           FontSize="15" FontWeight="600" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding PriceChangePercentage24H, StringFormat='{}{0:F2}%'}" 
                                           FontSize="13" FontWeight="500"
                                           Foreground="{Binding PriceChangePercentage24H, Converter={StaticResource PriceChangeToColor}}" 
                                           VerticalAlignment="Center" TextAlignment="End"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Content="⭐" FontSize="16"
                                        Command="{Binding $parent[UserControl].DataContext.ToggleFavoriteCommand}"
                                        CommandParameter="{Binding Id}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
