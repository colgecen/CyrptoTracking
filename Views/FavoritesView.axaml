<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:AvaloniaAppCrypto.Models"
             x:Class="AvaloniaAppCrypto.Views.FavoritesView">
    <ScrollViewer AllowAutoHide="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="28,24,28,32">
            <!-- Page Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#14202E" CornerRadius="8" Padding="10,8">
                        <TextBlock Text="⭐" FontSize="18"/>
                    </Border>
                    <StackPanel Spacing="0">
                        <TextBlock Text="Favoriler" FontSize="22" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Takip ettiğiniz coin'ler" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <Border IsVisible="{Binding FavoriteIds.Count, Converter={StaticResource InverseBoolConverter}}"
                    Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="16" Padding="48" HorizontalAlignment="Center" Margin="0,32">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <PathIcon Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                              Width="72" Height="72" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Favoriler boş" FontSize="18" FontWeight="600" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Takip etmek istediğiniz coinleri listeden yıldıza tıklayarak ekleyin."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding FavoriteIds.Count, Converter={StaticResource CountToVisibility}}"
                    Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Favori Listesi" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource BackgroundTertiaryBrush}" CornerRadius="12" Padding="8,3">
                                <TextBlock Text="{Binding FavoriteIds.Count}" FontSize="11" FontWeight="700" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Liste" Command="{Binding SetCoinViewModeCommand}" CommandParameter="List"
                                    BorderThickness="0" CornerRadius="8" Padding="12,6" FontSize="11" FontWeight="600"
                                    Background="{DynamicResource AccentBlueBrush}" Foreground="White"/>
                            <Button Content="Grid" Command="{Binding SetCoinViewModeCommand}" CommandParameter="Grid"
                                    BorderThickness="0" CornerRadius="8" Padding="12,6" FontSize="11" FontWeight="600"
                                    Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Header (sortable) -->
                    <Border Background="{DynamicResource BackgroundPrimaryBrush}" CornerRadius="8" Padding="16,10">
                        <Grid ColumnDefinitions="40,220,*,80,80,80,100,120,50">
                            <Button Content="#" Command="{Binding SortCoinsCommand}" CommandParameter="Rank" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Left"/>
                            <Button Grid.Column="1" Content="COIN" Command="{Binding SortCoinsCommand}" CommandParameter="Name" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Left"/>
                            <Button Grid.Column="2" Content="FİYAT" Command="{Binding SortCoinsCommand}" CommandParameter="Price" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                            <Button Grid.Column="3" Content="1s" Command="{Binding SortCoinsCommand}" CommandParameter="Change1h" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                            <Button Grid.Column="4" Content="24s" Command="{Binding SortCoinsCommand}" CommandParameter="Change24h" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                            <Button Grid.Column="5" Content="7g" Command="{Binding SortCoinsCommand}" CommandParameter="Change7d" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                            <Button Grid.Column="6" Content="HACİM" Command="{Binding SortCoinsCommand}" CommandParameter="Volume" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                            <Button Grid.Column="7" Content="MCAP" Command="{Binding SortCoinsCommand}" CommandParameter="MarketCap" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding FavoritedCoins}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="models:Coin">
                                <Border CornerRadius="10" Padding="16,10" Margin="0,2" Background="{DynamicResource BackgroundPrimaryBrush}">
                                    <Grid ColumnDefinitions="40,220,*,80,80,80,100,120,50">
                                        <TextBlock Text="{Binding MarketCapRank}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border CornerRadius="12" Width="28" Height="28" Background="{DynamicResource BackgroundTertiaryBrush}">
                                                <Image Source="{Binding ImageSource}" Width="22" Height="22"/>
                                            </Border>
                                            <StackPanel Spacing="0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="600" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Symbol}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentPrice, StringFormat='${0:N2}'}"
                                                   FontSize="14" FontWeight="600" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextAlignment="End" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PriceChangePercentage1H, StringFormat='{}{0:F2}%'}"
                                                   FontSize="12" FontWeight="500"
                                                   Foreground="{Binding PriceChangePercentage1H, Converter={StaticResource PriceChangeToColor}}"
                                                   TextAlignment="End" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PriceChangePercentage24H, StringFormat='{}{0:F2}%'}"
                                                   FontSize="12" FontWeight="500"
                                                   Foreground="{Binding PriceChangePercentage24H, Converter={StaticResource PriceChangeToColor}}"
                                                   TextAlignment="End" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PriceChangePercentage7D, StringFormat='{}{0:F2}%'}"
                                                   FontSize="12" FontWeight="500"
                                                   Foreground="{Binding PriceChangePercentage7D, Converter={StaticResource PriceChangeToColor}}"
                                                   TextAlignment="End" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding TotalVolume, Converter={StaticResource NumberFormat}}"
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="End" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding MarketCap, Converter={StaticResource NumberFormat}}"
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="End" VerticalAlignment="Center"/>
                                        <Button Grid.Column="8" Width="40" Height="40" Padding="0"
                                                Background="Transparent" BorderThickness="0" CornerRadius="20"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding $parent[UserControl].DataContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding Id}">
                                            <PathIcon Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                                                      Width="22" Height="22" Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteStarColor}}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
