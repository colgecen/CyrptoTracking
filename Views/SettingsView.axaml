<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaAppCrypto.Views.SettingsView">
    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="640">
            <TextBlock Text="Ayarlar" FontSize="22" FontWeight="700" Foreground="White"/>

            <Border Background="#1C1F2A" CornerRadius="16" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Görünüm" FontSize="16" FontWeight="600" Foreground="White"/>
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock Text="Tema" FontSize="14" Foreground="#8B8FA3" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="☀️ Açık" Background="Transparent" Foreground="#8B8FA3"
                                    BorderBrush="#2D3041" CornerRadius="8" Padding="16,8" FontSize="13"
                                    Command="{Binding ToggleThemeCommand}"/>
                            <Button Content="🌙 Koyu" Background="#3B82F6" Foreground="White"
                                    BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="13" FontWeight="600"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock Text="Para Birimi" FontSize="14" Foreground="#8B8FA3" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Width="120" Background="#1E2233" Foreground="White" 
                                  BorderBrush="#2D3041" CornerRadius="8">
                            <ComboBoxItem>USD</ComboBoxItem>
                            <ComboBoxItem>EUR</ComboBoxItem>
                            <ComboBoxItem>TRY</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1C1F2A" CornerRadius="16" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Bağlantı" FontSize="16" FontWeight="600" Foreground="White"/>
                    <Grid ColumnDefinitions="160,*">
                        <TextBlock Text="WebSocket" FontSize="14" Foreground="#8B8FA3" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Width="160" SelectedIndex="0" Background="#1E2233" Foreground="White" 
                                  BorderBrush="#2D3041" CornerRadius="8">
                            <ComboBoxItem>Otomatik</ComboBoxItem>
                            <ComboBoxItem>Binance</ComboBoxItem>
                            <ComboBoxItem>CoinCap</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1C1F2A" CornerRadius="16" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Hakkında" FontSize="16" FontWeight="600" Foreground="White"/>
                    <TextBlock Text="CryptoTrack v1.0.0" FontSize="15" FontWeight="600" Foreground="White"/>
                    <TextBlock Text="Avalonia UI + .NET 8" FontSize="13" Foreground="#8B8FA3"/>
                    <TextBlock Text="Gerçek zamanlı kripto para takip uygulaması" FontSize="13" Foreground="#5A5D6E"/>
                </StackPanel>
            </Border>

            <Button Content="Ayarları Kaydet" Background="#3B82F6" Foreground="White" 
                    BorderThickness="0" CornerRadius="8" Padding="16,10" FontSize="14" FontWeight="600"
                    HorizontalAlignment="Left" Command="{Binding ToggleThemeCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
