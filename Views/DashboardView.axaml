<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:AvaloniaAppCrypto.Models"
             xmlns:controls="using:AvaloniaAppCrypto.Controls"
             x:Class="AvaloniaAppCrypto.Views.DashboardView">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="28,24,28,32">

            <!-- Page Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                <StackPanel Spacing="2">
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Kripto piyasasının canlı görünümü" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="Yenile" Command="{Binding RefreshCommand}"
                            Background="{DynamicResource AccentBlueBrush}" Foreground="White"
                            BorderThickness="0" CornerRadius="8" Padding="14,7" FontSize="12" FontWeight="600"/>
                </StackPanel>
            </Grid>

            <!-- Summary Cards -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                <!-- Market Cap -->
                <Border CornerRadius="16" Padding="20" BoxShadow="0 8 24 0 #1A000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#14202E" Offset="0"/>
                            <GradientStop Color="#12161F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Piyasa Değeri" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1A2A3A" CornerRadius="8" Padding="6,4">
                                <TextBlock Text="🌍" FontSize="12"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalMarketCap}" FontSize="24" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#0F2A1A" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="{Binding MarketCapChange, StringFormat='{}▲ {0}'}" FontSize="11" FontWeight="600" Foreground="#0ECB81"/>
                            </Border>
                            <TextBlock Text="son 24s" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 24h Volume -->
                <Border Grid.Column="1" CornerRadius="16" Padding="20" BoxShadow="0 8 24 0 #1A000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1E2A2E" Offset="0"/>
                            <GradientStop Color="#12161F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="24s Hacim" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#1A2A2E" CornerRadius="8" Padding="6,4">
                                <TextBlock Text="📈" FontSize="12"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalVolume24h}" FontSize="24" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#0F2A1A" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="▲ 12%" FontSize="11" FontWeight="600" Foreground="#0ECB81"/>
                            </Border>
                            <TextBlock Text="artış" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- BTC Dominance -->
                <Border Grid.Column="2" CornerRadius="16" Padding="20" BoxShadow="0 8 24 0 #1A000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#2A241A" Offset="0"/>
                            <GradientStop Color="#12161F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="BTC Dominance" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#2A241A" CornerRadius="8" Padding="6,4">
                                <TextBlock Text="₿" FontSize="12" Foreground="#F7D354"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding BtcDominance}" FontSize="24" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#2A1A1A" CornerRadius="6" Padding="6,2">
                                <TextBlock Text="▼ 0.3%" FontSize="11" FontWeight="600" Foreground="#F6465D"/>
                            </Border>
                            <TextBlock Text="son 7g" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fear & Greed -->
                <Border Grid.Column="3" CornerRadius="16" Padding="20" BoxShadow="0 8 24 0 #1A000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#241A2A" Offset="0"/>
                            <GradientStop Color="#12161F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Korku &amp; Açgözlülük" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#241A2A" CornerRadius="8" Padding="6,4">
                                <TextBlock Text="😱" FontSize="12"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding FearGreedIndex}" FontSize="24" FontWeight="700" Foreground="#F7D354"/>
                        <Border Background="#F7D354" CornerRadius="20" Padding="10,4" HorizontalAlignment="Left" Opacity="0.9">
                            <TextBlock Text="Açgözlü" FontSize="11" FontWeight="600" Foreground="#0B0E14"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Chart Section -->
            <Border CornerRadius="16" Padding="24" BoxShadow="0 8 24 0 #1A000000"
                    Background="{DynamicResource BackgroundSecondaryBrush}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#14202E" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="₿" FontSize="14" Foreground="#00D1FF" FontWeight="700"/>
                            </Border>
                            <StackPanel Spacing="0">
                                <TextBlock Text="Bitcoin" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="7 Günlük Fiyat Grafiği" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Content="1G" Command="{Binding LoadBtcChartCommand}" CommandParameter="1"
                                    Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                            <Button Content="1H" Command="{Binding LoadBtcChartCommand}" CommandParameter="7"
                                    Background="{DynamicResource AccentBlueBrush}" Foreground="White" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                            <Button Content="1Ay" Command="{Binding LoadBtcChartCommand}" CommandParameter="30"
                                    Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                            <Button Content="3Ay" Command="{Binding LoadBtcChartCommand}" CommandParameter="90"
                                    Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                            <Button Content="1Y" Command="{Binding LoadBtcChartCommand}" CommandParameter="365"
                                    Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource BackgroundPrimaryBrush}" CornerRadius="12" Height="290" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <controls:SparklineChart Values="{Binding BtcChartData}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Candlestick + Dominance row -->
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
                <!-- Candlestick -->
                <Border CornerRadius="16" Padding="24" BoxShadow="0 8 24 0 #1A000000"
                        Background="{DynamicResource BackgroundSecondaryBrush}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="#2A241A" CornerRadius="8" Padding="8,6">
                                    <TextBlock Text="📊" FontSize="14"/>
                                </Border>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="Mum Grafiği" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Bitcoin OHLC" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button Content="1H" Command="{Binding LoadBtcCandlesCommand}" CommandParameter="7"
                                        Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                                <Button Content="1Ay" Command="{Binding LoadBtcCandlesCommand}" CommandParameter="30"
                                        Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource BackgroundPrimaryBrush}" CornerRadius="12" Height="270" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <controls:CandlestickChart Candles="{Binding BtcCandleData}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Dominance Donut -->
                <Border Grid.Column="1" CornerRadius="16" Padding="24" BoxShadow="0 8 24 0 #1A000000"
                        Background="{DynamicResource BackgroundSecondaryBrush}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="Piyasa Dominansı" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Top 6 Coin" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-8,0,0"/>
                        <controls:DonutChart Segments="{Binding MarketSegments}" Height="180" Width="180" Margin="0,8,0,0"/>
                        <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding MarketSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Width="8" Height="8" CornerRadius="4">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Comparison Chart -->
            <Border CornerRadius="16" Padding="24" BoxShadow="0 8 24 0 #1A000000"
                    Background="{DynamicResource BackgroundSecondaryBrush}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#14202E" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="⚡" FontSize="14"/>
                            </Border>
                            <StackPanel Spacing="0">
                                <TextBlock Text="BTC vs ETH" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Karşılaştırmalı Fiyat Grafiği" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Content="7G" Command="{Binding LoadComparisonChartCommand}" CommandParameter="7"
                                    Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                            <Button Content="30G" Command="{Binding LoadComparisonChartCommand}" CommandParameter="30"
                                    Background="{DynamicResource BackgroundTertiaryBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" FontWeight="600"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource BackgroundPrimaryBrush}" CornerRadius="12" Height="230" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <controls:MultiLineChart Series="{Binding ComparisonSeries}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Fear & Greed + Top Gainers row -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border CornerRadius="16" Padding="24" BoxShadow="0 8 24 0 #1A000000"
                        Background="{DynamicResource BackgroundSecondaryBrush}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="Korku &amp; Açgözlülük Endeksi" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <controls:GaugeChart Value="{Binding FearGreedValue}" Height="150" Width="240" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FearGreedIndex}" FontSize="13" FontWeight="600" Foreground="#F7D354"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="16" Padding="24" BoxShadow="0 8 24 0 #1A000000"
                        Background="{DynamicResource BackgroundSecondaryBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="En Çok Yükselenler (24s)" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <controls:BarChart Segments="{Binding TopGainers}" Height="170"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Coin Table -->
            <Border CornerRadius="16" Padding="24" BoxShadow="0 8 24 0 #1A000000"
                    Background="{DynamicResource BackgroundSecondaryBrush}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#14202E" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="📋" FontSize="14"/>
                            </Border>
                            <StackPanel Spacing="0">
                                <TextBlock Text="Coin Listesi" FontSize="17" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Top 50 kripto para" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Liste" Command="{Binding SetCoinViewModeCommand}" CommandParameter="List"
                                    BorderThickness="0" CornerRadius="8" Padding="14,6" FontSize="12" FontWeight="600"
                                    Classes.active="{Binding IsListView}">
                                <Button.Styles>
                                    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
                                    <Style Selector="Button.active"><Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/><Setter Property="Foreground" Value="White"/></Style>
                                </Button.Styles>
                            </Button>
                            <Button Content="Grid" Command="{Binding SetCoinViewModeCommand}" CommandParameter="Grid"
                                    BorderThickness="0" CornerRadius="8" Padding="14,6" FontSize="12" FontWeight="600"
                                    Classes.active="{Binding IsGridView}">
                                <Button.Styles>
                                    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
                                    <Style Selector="Button.active"><Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/><Setter Property="Foreground" Value="White"/></Style>
                                </Button.Styles>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- List View -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsListView}">
                        <Border Background="{DynamicResource BackgroundPrimaryBrush}" CornerRadius="8" Padding="16,10">
                            <Grid ColumnDefinitions="40,220,*,110,90,90,110,50">
                                <Button Content="#" Command="{Binding SortCoinsCommand}" CommandParameter="Rank" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Left"/>
                                <Button Grid.Column="1" Content="COIN" Command="{Binding SortCoinsCommand}" CommandParameter="Name" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Left"/>
                                <Button Grid.Column="2" Content="FİYAT" Command="{Binding SortCoinsCommand}" CommandParameter="Price" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                                <Button Grid.Column="3" Content="1s" Command="{Binding SortCoinsCommand}" CommandParameter="Change1h" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                                <Button Grid.Column="4" Content="24s" Command="{Binding SortCoinsCommand}" CommandParameter="Change24h" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                                <Button Grid.Column="5" Content="7g" Command="{Binding SortCoinsCommand}" CommandParameter="Change7d" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                                <Button Grid.Column="6" Content="HACİM" Command="{Binding SortCoinsCommand}" CommandParameter="Volume" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="11" FontWeight="600" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FilteredCoins}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="models:Coin">
                                    <Border CornerRadius="10" Padding="16,10" Margin="0,2" Background="{DynamicResource BackgroundPrimaryBrush}">
                                        <Grid ColumnDefinitions="40,220,*,110,90,90,110,50">
                                            <TextBlock Text="{Binding MarketCapRank}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border CornerRadius="12" Width="28" Height="28" Background="{DynamicResource BackgroundTertiaryBrush}">
                                                    <Image Source="{Binding Image}" Width="22" Height="22"/>
                                                </Border>
                                                <StackPanel Spacing="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="600" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Symbol}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentPrice, StringFormat='${0:N2}'}"
                                                       FontSize="14" FontWeight="600" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextAlignment="End" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PriceChangePercentage1H, StringFormat='{}{0:F2}%'}"
                                                       FontSize="12" FontWeight="500"
                                                       Foreground="{Binding PriceChangePercentage1H, Converter={StaticResource PriceChangeToColor}}"
                                                       TextAlignment="End" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PriceChangePercentage24H, StringFormat='{}{0:F2}%'}"
                                                       FontSize="12" FontWeight="500"
                                                       Foreground="{Binding PriceChangePercentage24H, Converter={StaticResource PriceChangeToColor}}"
                                                       TextAlignment="End" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding PriceChangePercentage7D, StringFormat='{}{0:F2}%'}"
                                                       FontSize="12" FontWeight="500"
                                                       Foreground="{Binding PriceChangePercentage7D, Converter={StaticResource PriceChangeToColor}}"
                                                       TextAlignment="End" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding TotalVolume, Converter={StaticResource NumberFormat}}"
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="End" VerticalAlignment="Center"/>
                                            <Button Grid.Column="7" Background="Transparent" BorderThickness="0"
                                                    Content="{Binding IsFavorite, Converter={StaticResource BoolToStar}}" FontSize="15"
                                                    Command="{Binding $parent[UserControl].DataContext.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding Id}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Grid View -->
                    <ItemsControl ItemsSource="{Binding FilteredCoins}" IsVisible="{Binding IsGridView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="models:Coin">
                                <Border Width="220" CornerRadius="14" Padding="16" Margin="6" Background="{DynamicResource BackgroundPrimaryBrush}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="12" Width="30" Height="30" Background="{DynamicResource BackgroundTertiaryBrush}">
                                                    <Image Source="{Binding Image}" Width="22" Height="22"/>
                                                </Border>
                                                <StackPanel Spacing="0">
                                                    <TextBlock Text="{Binding Symbol}" FontSize="13" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MarketCapRank, StringFormat='#{0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding CurrentPrice, StringFormat='${0:N2}'}" FontSize="18" FontWeight="700" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="24s" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding PriceChangePercentage24H, StringFormat='{}{0:F2}%'}"
                                                           FontSize="12" FontWeight="600"
                                                           Foreground="{Binding PriceChangePercentage24H, Converter={StaticResource PriceChangeToColor}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Hacim" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding TotalVolume, Converter={StaticResource NumberFormat}}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!-- Loading -->
                    <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="16" Padding="48"
                            IsVisible="{Binding Coins.Count, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <TextBlock Text="Veriler yükleniyor..." FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
