        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#0B0E14" BorderBrush="#1F2532" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0" VerticalAlignment="Center">
                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Width="36" Height="36" Padding="0" CornerRadius="11"
                            Background="#12161F" BorderBrush="#1F2532" BorderThickness="1"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Menüyü aç / kapat"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                            <Border Width="16" Height="2" CornerRadius="1" Background="#A7B0BF"/>
                            <Border Width="16" Height="2" CornerRadius="1" Background="#A7B0BF"/>
                            <Border Width="16" Height="2" CornerRadius="1" Background="#A7B0BF"/>
                        </StackPanel>
                    </Button>
                    <Border CornerRadius="12" Width="34" Height="34" VerticalAlignment="Center"
                            BorderBrush="#2A3244" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="₿" FontSize="19" FontWeight="800"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="CryptoTrack" FontSize="17" FontWeight="800" Foreground="#F8FAFF"/>
                        <TextBlock Text="PRO" FontSize="8" FontWeight="800" Foreground="#00D1FF" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="1" Background="#12161F" CornerRadius="14" Padding="12,0" Height="42"
                        MinWidth="420" MaxWidth="720"
                        HorizontalAlignment="Stretch" BorderBrush="#1F2532" BorderThickness="1.2">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <PathIcon Grid.Column="0"
                                  Data="M10 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm8.32-2.68l4.18 4.18-1.41 1.41-4.18-4.18a9 9 0 1 1 1.41-1.41z"
                                  Width="14" Height="14" Foreground="#7A8398" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery}"
                                 PlaceholderText="Coin fiyatını, hacmi veya sembolü arayın…"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#F8FAFF" FontSize="14" Padding="0"
                                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                 CaretBrush="#00D1FF"/>
                        <Border Grid.Column="2" Background="#1A1F2B" CornerRadius="7" Padding="8,3" BorderBrush="#252C3C" BorderThickness="1">
                            <TextBlock Text="/" FontSize="11" FontWeight="700" Foreground="#8A92A2"/>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
